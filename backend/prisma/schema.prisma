datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InteractionType {
  QUESTION_GENERATION
  HINT_REQUEST
  ANSWER_EVALUATION
}

enum AssessmentType {
  SINGLE_TOPIC
  MULTI_TOPIC
}

// ---------- PROFILE ENUMS ----------

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ResumeFileType {
  PDF
  DOCX
}

enum PlanTier {
  FREE
  PRO
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  name            String
  passwordHash    String?
  provider        String              @default("local")
  googleId        String?
  avatarUrl       String?
  avatarUploadedAt DateTime?
  isEmailVerified Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        AssessmentSession[]

  profile           Profile?
  resumes           Resume[]
  topicsOfInterest  TopicOfInterest[]
  waypoints         UserWaypoint[]

  @@map("users")
}

model Topic {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sessions      AssessmentSession[]
  questions     Question[]
  sessionTopics SessionTopic[]

  interestedUsers TopicOfInterest[]

  @@map("topics")
}

model AssessmentSession {
  id                       String          @id @default(uuid())
  userId                   String
  topicId                  String
  assessmentType           AssessmentType  @default(SINGLE_TOPIC)
  status                   SessionStatus   @default(IN_PROGRESS)
  difficulty               Difficulty
  score                    Int?
  feedback                 String?
  evaluationStatus         String          @default("PENDING")
  currentQuestionOrder     Int             @default(1)
  totalQuestions           Int             @default(5)
  questionGenerationPrompt String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  startedAt                DateTime?
  completedAt              DateTime?
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions                Question[]
  answers                  Answer[]
  aiAssistance             AIAssistance[]
  aiInteractions           AIInteraction[]
  sessionTopics            SessionTopic[]

  @@index([userId])
  @@index([topicId])
  @@map("assessment_sessions")
}

model SessionTopic {
  id                 String            @id @default(uuid())
  sessionId          String
  topicId            String
  topicNameSnapshot  String
  session            AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic              Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([sessionId, topicId])
  @@index([sessionId])
  @@index([topicId])
  @@map("session_topics")
}

model Question {
  id            String            @id @default(uuid())
  sessionId     String
  topicId       String
  text          String
  difficulty    Difficulty
  correctAnswer String?
  questionOrder Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic         Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers       Answer[]
  aiAssistance  AIAssistance[]

  @@unique([sessionId, questionOrder])
  @@index([sessionId])
  @@index([topicId])
  @@map("questions")
}

model Answer {
  id               String            @id @default(uuid())
  sessionId        String
  questionId       String
  userResponse     String
  feedback         String?
  score            Int?
  expectedConcepts String[]
  breakdown        Json?
  strengths        String[]
  improvements     String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  session          AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("answers")
}

model AIAssistance {
  id         String            @id @default(uuid())
  sessionId  String
  questionId String
  aiResponse Json
  usedAt     DateTime          @default(now())
  createdAt  DateTime          @default(now())
  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("ai_assistance")
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

model AIInteraction {
  id         String            @id @default(uuid())
  sessionId  String
  role       ChatRole
  content    String
  tokensUsed Int?
  createdAt  DateTime          @default(now())

  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@map("ai_interactions")
}

// ---------- PROFILE MODELS ----------

model Profile {
  id                   String          @id @default(uuid())
  userId               String          @unique
  role                 String?
  homePort             String?
  bio                  String?
  experienceLevel      ExperienceLevel @default(INTERMEDIATE)
  timezone             String?
  streakDays           Int             @default(0)
  lastActiveDate       DateTime?       @db.Date
  planTier             PlanTier        @default(FREE)
  aiUsesLimit          Int             @default(10)
  currentPeriodStart   DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Resume {
  id             String         @id @default(uuid())
  userId         String
  fileKey        String
  fileName       String
  fileType       ResumeFileType
  fileSizeBytes  Int
  isPrimary      Boolean        @default(false)
  uploadedAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  parsedData     Json?
  parsedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // NOTE: Prisma can't express a partial unique index (WHERE is_primary = true)
  // in schema syntax. This @@index is just for query performance —
  // the actual "only one primary per user" constraint is added by hand
  // to the generated migration.sql. See instructions below.
  @@index([userId, isPrimary])
  @@map("resumes")
}

model TopicOfInterest {
  id        String   @id @default(uuid())
  userId    String
  topicId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("topics_of_interest")
}

model Waypoint {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  unlockedBy UserWaypoint[]

  @@map("waypoints")
}

model UserWaypoint {
  id         String   @id @default(uuid())
  userId     String
  waypointId String
  unlockedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  waypoint Waypoint @relation(fields: [waypointId], references: [id], onDelete: Cascade)

  @@unique([userId, waypointId])
  @@map("user_waypoints")
}