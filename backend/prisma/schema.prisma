datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum InteractionType {
  QUESTION_GENERATION
  HINT_REQUEST
  ANSWER_EVALUATION
}

enum AssessmentType {
  SINGLE_TOPIC
  MULTI_TOPIC
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  name            String
  passwordHash    String?
  provider        String              @default("local")
  googleId        String?
  avatarUrl       String?
  isEmailVerified Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  sessions        AssessmentSession[]

  @@map("users")
}

model Topic {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  sessions      AssessmentSession[]
  questions     Question[]
  sessionTopics SessionTopic[]

  @@map("topics")
}

model AssessmentSession {
  id                       String          @id @default(uuid())
  userId                   String
  topicId                  String
  assessmentType           AssessmentType  @default(SINGLE_TOPIC)
  status                   SessionStatus   @default(IN_PROGRESS)
  difficulty               Difficulty
  score                    Int?
  feedback                 String?
  evaluationStatus         String          @default("PENDING")
  currentQuestionOrder     Int             @default(1)
  totalQuestions           Int             @default(5)
  questionGenerationPrompt String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  startedAt                DateTime?
  completedAt              DateTime?
  user                     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic                    Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions                Question[]
  answers                  Answer[]
  aiAssistance             AIAssistance[]
  aiInteractions           AIInteraction[]
  sessionTopics            SessionTopic[]

  @@index([userId])
  @@index([topicId])
  @@map("assessment_sessions")
}

model SessionTopic {
  id                 String            @id @default(uuid())
  sessionId          String
  topicId            String
  topicNameSnapshot  String
  session            AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic              Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([sessionId, topicId])
  @@index([sessionId])
  @@index([topicId])
  @@map("session_topics")
}

model Question {
  id            String            @id @default(uuid())
  sessionId     String
  topicId       String
  text          String
  difficulty    Difficulty
  correctAnswer String?
  questionOrder Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  session       AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic         Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers       Answer[]
  aiAssistance  AIAssistance[]
  aiInteractions AIInteraction[]

  @@unique([sessionId, questionOrder])
  @@index([sessionId])
  @@index([topicId])
  @@map("questions")
}

model Answer {
  id               String            @id @default(uuid())
  sessionId        String
  questionId       String
  userResponse     String
  feedback         String?
  score            Int?
  expectedConcepts String[]
  breakdown        Json?
  strengths        String[]
  improvements     String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  session          AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("answers")
}

model AIAssistance {
  id         String            @id @default(uuid())
  sessionId  String
  questionId String
  aiResponse Json
  usedAt     DateTime          @default(now())
  createdAt  DateTime          @default(now())
  session    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
  @@map("ai_assistance")
}

model AIInteraction {
  id               String            @id @default(uuid())
  sessionId        String
  questionId       String?
  type             InteractionType
  prompt           String
  response         String
  tokensUsed       Int?
  promptTokens     Int?
  completionTokens Int?
  modelName        String?           @db.VarChar(100)
  promptVersion    String?
  createdAt        DateTime          @default(now())
  session          AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question?         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([questionId])
  @@map("ai_interactions")
}
